<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.PoseGame" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryDark">@color/purple_dark</item>
        <item name="colorAccent">@color/purple_primary</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/purple_dark</item>
    </style>

    <!-- Fullscreen theme for camera -->
    <style name="Theme.PoseGame.Fullscreen" parent="Theme.PoseGame">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>