<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".PoseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PoseGame"
        android:usesCleartextTraffic="true">

        <!-- Login/Register -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.PoseGame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

        <!-- Main -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

        <!-- Level Detail -->
        <activity
            android:name=".ui.level.LevelDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

        <!-- Camera -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PoseGame.Fullscreen" />

        <!-- Result -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

        <!-- Leaderboard -->
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

        <!-- Sticker Wall -->
        <activity
            android:name=".ui.sticker.StickerWallActivity"
            android:exported="false"
            android:theme="@style/Theme.PoseGame" />

    </application>

</manifest>